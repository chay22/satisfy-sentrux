# Set default behavior to automatically handle line endings and enforce LF
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
